# Local development. Copy to .env and fill in. In AWS, the same keys live in the Secrets Manager JSON
# named by configSecretName (see deploy/moduleRegistry.json); never commit real values.

appEnv=dev
awsRegion=ap-south-1
mainTableName=up4ds-dev-main
corsOrigins=["http://localhost:5173"]
appBaseUrl=http://localhost:5173

anthropicApiKey=
claudeModel=claude-opus-5-5
deepgramApiKey=
deepgramModel=nova-3

# Sahai production-backend (ABDM M1 to M3). This app is one Sahai customer with its own API key.
sahaiBaseUrl=https://4sdj5gmx8g.execute-api.ap-south-1.amazonaws.com
sahaiApiKey=
sahaiWebhookSecret=
abdmHipId=
abdmHiuId=

# Leave WhatsApp empty to skip sending (messages are logged instead).
whatsAppAccessToken=
whatsAppPhoneNumberId=
whatsAppApiVersion=v22.0

# Shared secret the calling agent sends as X-Channel-Token.
parentChannelToken=
noImprovementAlertWeeks=2
